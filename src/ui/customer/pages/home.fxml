<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="background-container" stylesheets="@/styles/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.customer.pages.HomePage">
    <children>
        <AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: transparent;" styleClass="root">
            <children>
                <VBox alignment="TOP_CENTER" spacing="15.0" styleClass="card" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
                    <children>
                        <!-- Top Bar -->
                        <HBox alignment="CENTER" prefHeight="30.0" prefWidth="200.0">
                            <children>
                                <Button fx:id="cartButton" onAction="#handleCart" contentDisplay="GRAPHIC_ONLY" prefHeight="30.0" styleClass="primary-btn, icon-button">
                                    <graphic>
                                        <ImageView fx:id="iconCartView" fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true" />
                                    </graphic>
                                </Button>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="welcomeLabel" alignment="CENTER" styleClass="title-text" text="Home" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="logoutButton" onAction="#handleLogout" contentDisplay="GRAPHIC_ONLY" styleClass="primary-btn, icon-button">
                                    <graphic>
                                        <ImageView fx:id="iconLogoutView" fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true" />
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>

                        <!-- Navigation Buttons -->
                        <HBox fx:id="customerButtons" alignment="CENTER" spacing="20.0">
                            <children>
                                <Button onAction="#handleWishList" prefWidth="120.0" styleClass="primary-btn" text="Wish List" />
                                <Button onAction="#handleProfile" prefWidth="120.0" styleClass="primary-btn" text="Profile" />
                                <Button onAction="#handleOrders" prefWidth="120.0" styleClass="primary-btn" text="Orders" />
                            </children>
                        </HBox>

                        <Separator prefWidth="200.0" />

                        <!-- NEW: Search Bar -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <TextField fx:id="searchField" promptText="Search products..." prefWidth="300.0" />
                            <Button text="Search" onAction="#handleSearch" styleClass="primary-btn"/>
                            <Button text="Clear" onAction="#handleClearSearch" styleClass="secondary-btn"/>
                            <ProgressIndicator fx:id="loadingSpinner" prefHeight="25.0" prefWidth="25.0" visible="false"/>
                        </HBox>

                        <!-- Content Area: StackPane to swap between Accordion and Search Results -->
                        <StackPane VBox.vgrow="ALWAYS">
                            <Accordion fx:id="categoryAccordion" />
                            <ListView fx:id="searchResultsList" visible="false" styleClass="list-view"/>
                            <Label fx:id="noResultsLabel" text="No products found." visible="false" styleClass="muted"/>
                        </StackPane>

                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>