<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="background-container" stylesheets="@/styles/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.customer.pages.OrdersPage">
    <children>
        <AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: transparent;" styleClass="root">
            <children>
                <VBox alignment="TOP_CENTER" spacing="15.0" styleClass="card" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Button alignment="CENTER" contentDisplay="GRAPHIC_ONLY" onMouseClicked="#handleBack" text="Back">
                                    <graphic>
                                        <ImageView fx:id="iconReturn" fitHeight="30" fitWidth="30" pickOnBounds="true" preserveRatio="true" />
                                    </graphic>
                                    <styleClass>
                                        <String fx:value="primary-btn" />
                                        <String fx:value="icon-button" />
                                    </styleClass>
                                </Button>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label alignment="CENTER" styleClass="title-text" text="My Orders" />
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <Separator />

                        <HBox alignment="CENTER" spacing="15.0">
                            <ToggleButton fx:id="btnActive" prefWidth="150.0" selected="true" styleClass="primary-btn" text="Active Orders" />
                            <ToggleButton fx:id="btnPast" prefWidth="150.0" styleClass="secondary-btn" text="History" />
                        </HBox>

                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="cardContainer" spacing="10.0">
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>

                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>