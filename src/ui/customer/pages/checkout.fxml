<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" styleClass="card" stylesheets="@/styles/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.customer.pages.CheckoutPage">
    <children>
        <Label styleClass="title-text" text="Confirm Your Order">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <VBox spacing="10" style="-fx-border-color: #ccc; -fx-padding: 10; -fx-border-radius: 5; -fx-max-width: 400;">
            <children>
                <Label text="Shipping To:" style="-fx-font-weight: bold;" />
                <Label fx:id="addressLabel" text="[Customer Address]" />
            </children>
        </VBox>

        <GridPane hgap="10" vgap="5" style="-fx-max-width: 400;">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Subtotal:" GridPane.rowIndex="0" />
                <Label fx:id="subtotalLabel" text="\$0.00" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label text="Shipping:" GridPane.rowIndex="1" />
                <Label fx:id="shippingLabel" text="\$0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Payment Fee:" GridPane.rowIndex="2" />
                <Label fx:id="paymentFeeLabel" text="\$0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Taxes (15%):" GridPane.rowIndex="3" />
                <Label fx:id="taxesLabel" text="\$0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Grand Total:" style="-fx-font-weight: bold; -fx-font-size: 16;" GridPane.rowIndex="4" />
                <Label fx:id="grandTotalLabel" text="\$0.00" style="-fx-font-weight: bold; -fx-font-size: 16;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </children>
        </GridPane>

        <HBox alignment="CENTER" spacing="10">
            <Label text="Choose Shipping:" />
            <ChoiceBox fx:id="shippingChoiceBox" prefWidth="200.0" />
        </HBox>
        
        <HBox alignment="CENTER" spacing="10">
            <Label text="Payment Method:" />
            <ChoiceBox fx:id="paymentChoiceBox" prefWidth="200.0" />
        </HBox>

        <Label fx:id="errorLabel" styleClass="error-text" />

        <HBox alignment="CENTER" spacing="20">
            <Button onAction="#handleConfirmAndPay" prefWidth="150.0" styleClass="primary-btn" text="Confirm &amp; Pay" />
            <Button onAction="#handleCancel" prefWidth="120.0" styleClass="secondary-btn" text="Cancel" />
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
