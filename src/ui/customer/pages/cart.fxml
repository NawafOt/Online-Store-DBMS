<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane styleClass="background-container" stylesheets="@/styles/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.customer.pages.CartPage">
    <children>
        <AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: transparent;" styleClass="root">
            <children>
                <VBox alignment="TOP_CENTER" spacing="15.0" styleClass="card" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Button alignment="CENTER" contentDisplay="GRAPHIC_ONLY" graphicTextGap="1.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#handleBack" text="Back" textAlignment="CENTER">
                                    <graphic>
                                        <ImageView fx:id="iconReturn" fitHeight="30" fitWidth="30" pickOnBounds="true" preserveRatio="true" />
                                    </graphic>
                                    <styleClass>
                                        <String fx:value="primary-btn" />
                                        <String fx:value="icon-button" />
                                    </styleClass>
                                </Button>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label alignment="CENTER" styleClass="title-text" text="My Shopping Cart" />
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="cardContainer" alignment="TOP_CENTER" spacing="12">
                                    <padding>
                                        <Insets bottom="12" left="12" right="12" top="12" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                        <Separator />
                        <HBox alignment="CENTER_RIGHT" prefHeight="50.0" spacing="20.0">
                            <children>
                                <Label fx:id="totalLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Total: \$0.00" />
                                <Button fx:id="clearAllButton" onAction="#handleClearAll" prefWidth="100.0" styleClass="danger-btn" text="Clear All" />
                                <Button fx:id="checkoutButton" onAction="#handleCheckout" prefWidth="100.0" styleClass="primary-btn" text="Checkout" />
                            </children>
                            <padding>
                                <Insets right="20.0" />
                            </padding>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>
