<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" styleClass="card" stylesheets="@/styles/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.customer.pages.ProductDetailsPage">
    <children>
        <Label fx:id="productNameLabel" styleClass="title-text" text="Product Name">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <HBox alignment="CENTER" spacing="10">
            <Label text="Price:" />
            <Label fx:id="priceLabel" text="\$0.00" />
        </HBox>

        <HBox alignment="CENTER" spacing="10">
            <Label text="Category:" />
            <Label fx:id="categoryLabel" text="Category" />
        </HBox>

        <HBox alignment="CENTER" spacing="10">
            <Label text="In Stock:" />
            <Label fx:id="stockLabel" text="0" />
        </HBox>

        <Label fx:id="feedbackLabel" styleClass="accent" />

        <HBox alignment="CENTER" spacing="10">
            <Label text="Quantity:" />
            <Spinner fx:id="quantitySpinner" prefWidth="80.0" />
            <Button fx:id="addToCartButton" onAction="#handleAddToCart" prefWidth="120.0" styleClass="primary-btn" text="Add to Cart" />
        </HBox>
        
        <Button fx:id="addToWishlistButton" onAction="#handleAddToWishlist" prefWidth="140.0" styleClass="primary-btn" text="Add to Wishlist" />
        
        <Button onAction="#handleBack" prefWidth="120.0" styleClass="secondary-btn" text="Back to Home" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
