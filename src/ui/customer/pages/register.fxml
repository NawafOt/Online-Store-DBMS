<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane styleClass="background-container" stylesheets="@../../../../resources/styles/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.customer.pages.RegisterPage">
    <children>
        <AnchorPane maxHeight="400.0" maxWidth="600.0" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: transparent;" styleClass="root">
            <children>
                <VBox alignment="TOP_CENTER" spacing="15.0" styleClass="card" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
                    <children>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                            <children>
                                <Button alignment="CENTER" contentDisplay="GRAPHIC_ONLY" graphicTextGap="1.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onMouseClicked="#handleReturn" text="EXIT" textAlignment="CENTER">
                                    <graphic>
                                        <ImageView fx:id="iconReturnView" fitHeight="30" fitWidth="30" pickOnBounds="true" preserveRatio="true">
                                        </ImageView>
                                    </graphic>
                                    <styleClass>
                                        <String fx:value="primary-btn" />
                                        <String fx:value="icon-button" />
                                    </styleClass>
                                </Button>
                                <Region prefHeight="38.0" prefWidth="72.0" />
                                <Label alignment="CENTER" prefHeight="35.0" prefWidth="260.0" styleClass="title-text" text="Register New Account" textAlignment="CENTER" />
                            </children>
                        </HBox>

                        <GridPane alignment="CENTER" hgap="10.0" vgap="30.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>

                            <Label text="Name" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <font>
                                    <Font size="16.0" />
                                </font>
                            </Label>
                            <TextField promptText="Example: John Doe" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Label text="Email" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <font>
                                    <Font size="16.0" />
                                </font>
                            </Label>
                            <TextField promptText="example@domain.com" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label text="Phone Number" GridPane.rowIndex="2">
                                <font>
                                    <Font size="16.0" />
                                </font>
                            </Label>
                            <TextField promptText="+966 xxx xxx xxxx" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                            <Label text="Password" GridPane.rowIndex="3">
                                <font>
                                    <Font size="16.0" />
                                </font>
                            </Label>
                            <PasswordField promptText="Between 3 and 12 Characters" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                            <Label text="Address" GridPane.rowIndex="4">
                                <font>
                                    <Font size="16.0" />
                                </font>
                            </Label>
                            <TextField promptText="City, State ZIPCODE" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </GridPane>

                        <Button mnemonicParsing="false" prefWidth="100.0" styleClass="primary-btn" text="Register!">
                            <VBox.margin>
                                <Insets bottom="5.0" top="10.0" />
                            </VBox.margin>
                        </Button>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>
