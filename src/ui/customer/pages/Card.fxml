<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.customer.pages.CardController"
      spacing="6" styleClass="card" fx:id="root"
      stylesheets="/styles/app.css">

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label fx:id="titleLabel" styleClass="title-text" wrapText="true"/>
        <Region HBox.hgrow="ALWAYS"/>
        <MenuButton fx:id="menuBtn" styleClass="icon-button" text="⋮">
            <font>
                <Font name="System Bold" size="12.0"/>
            </font>
        </MenuButton>
    </HBox>

    <Label fx:id="line1"/>
    <Label fx:id="line2" styleClass="muted"/>
</VBox>
