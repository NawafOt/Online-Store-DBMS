<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane styleClass="background-container" stylesheets="@/styles/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.admin.pages.CustomerManagementPage">
    <children>
        <AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: transparent;">
            <children>
                <VBox spacing="15.0" styleClass="card" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <Button mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-btn" text="← Back" />
                            <Label styleClass="title-text" text="Customer Management">
                                <font>
                                    <Font size="24.0" />
                                </font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <TextField fx:id="searchField" prefWidth="200.0" promptText="Search by name..." />
                            <Button mnemonicParsing="false" onAction="#handleSearch" styleClass="primary-btn" text="Search" />
                        </HBox>

                        <Separator />

                        <!-- Main Content -->
                        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                            <!-- Left: Form -->
                            <VBox prefWidth="320.0" spacing="12.0">
                                <Label styleClass="accent" text="Customer Details" />

                                <VBox spacing="5.0">
                                    <Label text="Full Name" />
                                    <TextField fx:id="nameField" promptText="John Doe" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label text="Email Address" />
                                    <TextField fx:id="emailField" promptText="email@example.com" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label text="Phone Number" />
                                    <TextField fx:id="phoneField" promptText="05xxxxxxxx" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label text="Address" />
                                    <TextField fx:id="addressField" promptText="City, Street" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label text="Password" />
                                    <PasswordField fx:id="passwordField" promptText="Enter password" />
                                    <Label styleClass="muted" text="(Required for new users)" textFill="#909090">
                                        <font>
                                            <Font size="10.0" />
                                        </font>
                                    </Label>
                                </VBox>

                                <Region prefHeight="10.0" />

                                <HBox alignment="CENTER" spacing="10.0">
                                    <Button mnemonicParsing="false" onAction="#handleAdd" prefWidth="80.0" styleClass="primary-btn" text="Add" />
                                    <Button mnemonicParsing="false" onAction="#handleUpdate" prefWidth="80.0" styleClass="primary-btn" text="Update" />
                                    <Button mnemonicParsing="false" onAction="#handleDelete" prefWidth="80.0" styleClass="primary-btn" text="Delete" />
                                </HBox>

                                <Button mnemonicParsing="false" onAction="#handleClear" prefWidth="280.0" styleClass="secondary-btn" text="Clear Form" />

                                <Label fx:id="statusLabel" wrapText="true" />
                            </VBox>

                            <!-- Right: Table -->
                            <TableView fx:id="customerTable" HBox.hgrow="ALWAYS" styleClass="table-view">
                                <columns>
                                    <TableColumn fx:id="colId" prefWidth="50.0" text="ID"/>
                                    <TableColumn fx:id="colName" prefWidth="150.0" text="Name" />
                                    <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email" />
                                    <TableColumn fx:id="colPhone" prefWidth="120.0" text="Phone" />
                                    <TableColumn fx:id="colAddress" prefWidth="200.0" text="Address" />
                                </columns>
                                <placeholder>
                                    <Label text="No customers found" />
                                </placeholder>
                            </TableView>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>
