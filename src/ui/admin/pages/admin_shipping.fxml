<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane styleClass="background-container" stylesheets="@/styles/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.admin.pages.ShippingManagementPage">
    <children>
        <AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: transparent;">
            <children>
                <VBox spacing="15.0" styleClass="card" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <Button mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-btn" text="← Back" />
                            <Label styleClass="title-text" text="Shipping Companies">
                                <font>
                                    <Font size="24.0" />
                                </font>
                            </Label>
                        </HBox>

                        <Separator />

                        <!-- Content -->
                        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                            <!-- Left: Form -->
                            <VBox prefWidth="300.0" spacing="12.0">
                                <Label styleClass="accent" text="Company Details" />

                                <VBox spacing="5.0">
                                    <Label text="Company Name" />
                                    <TextField fx:id="nameField" promptText="e.g. FedEx" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label text="Phone Number" />
                                    <TextField fx:id="phoneField" promptText="Contact Number" />
                                </VBox>

                                <VBox spacing="5.0">
                                    <Label text="Shipping Cost ($)" />
                                    <TextField fx:id="costField" promptText="15.00" />
                                </VBox>

                                <Region prefHeight="10.0" />

                                <HBox alignment="CENTER" spacing="10.0">
                                    <Button mnemonicParsing="false" onAction="#handleAdd" prefWidth="80.0" styleClass="primary-btn" text="Add" />
                                    <Button mnemonicParsing="false" onAction="#handleUpdate" prefWidth="80.0" styleClass="primary-btn" text="Update" />
                                    <Button mnemonicParsing="false" onAction="#handleDelete" prefWidth="80.0" styleClass="primary-btn" text="Delete" />
                                </HBox>

                                <Button mnemonicParsing="false" onAction="#handleClear" prefWidth="260.0" styleClass="secondary-btn" text="Clear Form" />
                                <Label fx:id="statusLabel" wrapText="true" />
                            </VBox>

                            <!-- Right: Table -->
                            <TableView fx:id="shippingTable" HBox.hgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                                    <TableColumn fx:id="colName" prefWidth="200.0" text="Company Name" />
                                    <TableColumn fx:id="colPhone" prefWidth="150.0" text="Phone" />
                                    <TableColumn fx:id="colCost" prefWidth="100.0" text="Cost" />
                                </columns>
                                <placeholder>
                                    <Label text="No shipping companies found" />
                                </placeholder>
                            </TableView>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>