<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane styleClass="background-container" stylesheets="@/styles/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.admin.pages.AdminHomePage">
    <children>
    <AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: transparent;">
        <children>
        <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="card" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="200.0" AnchorPane.topAnchor="50.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>

            <Region prefHeight="20.0" />
            <Label fx:id="welcomeLabel" styleClass="title-text" text="Admin Dashboard">
                <font>
                    <Font size="28.0" />
                </font>
            </Label>

                <HBox alignment="CENTER" spacing="20.0">
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding>

                    <!-- Card 1: Revenue -->
                    <VBox alignment="CENTER" prefHeight="100.0" prefWidth="250.0" style="-fx-background-color: #EAFBFF; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);">
                        <children>
                            <Label styleClass="muted" text="Total Revenue" />
                            <Label fx:id="lblTotalRevenue" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #263743;" text="\$0.00" />
                        </children>
                    </VBox>

                    <!-- Card 2: Orders -->
                    <VBox alignment="CENTER" layoutX="10.0" layoutY="10.0" prefHeight="100.0" prefWidth="250.0" style="-fx-background-color: #EAFBFF; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);">
                        <children>
                            <Label styleClass="muted" text="Total Orders" />
                            <Label fx:id="lblTotalOrders" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #263743;" text="0" />
                        </children>
                    </VBox>

                    <!-- Card 3: Customers -->
                    <VBox alignment="CENTER" layoutX="210.0" layoutY="10.0" prefHeight="100.0" prefWidth="250.0" style="-fx-background-color: #EAFBFF; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);">
                        <children>
                            <Label styleClass="muted" text="Total Customers" />
                            <Label fx:id="lblTotalCustomers" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #263743;" text="0" />
                        </children>
                    </VBox>
                </HBox>

            <Separator>
                <padding>
                    <Insets bottom="15.0" top="15.0" />
                </padding>
            </Separator>

            <VBox alignment="CENTER" spacing="15.0">
                <Button mnemonicParsing="false" onAction="#handleProducts" prefHeight="50.0" prefWidth="250.0" styleClass="primary-btn" text="Manage Products">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#handleCustomers" prefHeight="50.0" prefWidth="250.0" styleClass="primary-btn" text="Manage Customers">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#handleOrders" prefHeight="50.0" prefWidth="250.0" styleClass="primary-btn" text="Manage Orders">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#handleShipping" prefHeight="50.0" prefWidth="250.0" styleClass="primary-btn" text="Manage Shipping">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Separator>
                <padding>
                    <Insets bottom="10.0" top="10.0" />
                </padding>
            </Separator>

            <Button mnemonicParsing="false" onAction="#handleLogout" prefWidth="150.0" styleClass="primary-btn" text="Logout">
                <font>
                    <Font size="14.0" />
                </font>
            </Button>
            </children>
        </VBox>
        </children>
    </AnchorPane>
    </children>
</StackPane>
