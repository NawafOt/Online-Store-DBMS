<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane styleClass="background-container" stylesheets="@../../resources/styles/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.LoginPage">
   <children>
      <AnchorPane maxHeight="400.0" maxWidth="600.0" prefHeight="400.0" prefWidth="600.0" styleClass="root" stylesheets="@../../resources/styles/app.css">
          <children>
              <VBox alignment="TOP_CENTER" spacing="15.0" styleClass="card" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="50.0">
                  <children>
                      <Label alignment="CENTER" styleClass="title-text" text="Login" textAlignment="CENTER" />
      
                      <VBox spacing="10.0">
                          <Label text="Phone Number or E-mail" />
                          <TextField promptText="Enter Email/Phone" />
                          <Label text="Password" />
                          <TextField promptText="Your Account Password" />
                      </VBox>
      
                      <Button mnemonicParsing="false" prefWidth="100.0" styleClass="primary-btn" text="Continue" />
      
                      <Separator prefHeight="6.0" prefWidth="600.0" />
      
                      <Label alignment="CENTER" styleClass="accent" text="Never signed in before? Register now or enter as a guest!" textAlignment="CENTER" wrapText="true" />
      
                      <HBox alignment="CENTER" spacing="10.0">
                          <Button mnemonicParsing="false" styleClass="primary-btn" text="Register" />
                          <Button mnemonicParsing="false" styleClass="primary-btn" text="Guest Mode" />
                      </HBox>
                  </children>
              </VBox>
          </children>
      </AnchorPane>
   </children>
</StackPane>

