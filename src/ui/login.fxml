<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="400.0" maxWidth="600.0" prefHeight="400.0" prefWidth="600.0" styleClass="root" stylesheets="@../../resources/styles/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.LoginPage">
    <children>
        <VBox alignment="TOP_CENTER" prefHeight="300.0" prefWidth="400.0" spacing="15.0" styleClass="card" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="100.0">
            <children>

                <Label alignment="CENTER" styleClass="title-text" text="Login" textAlignment="CENTER">
                    <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                    </VBox.margin>
                </Label>

                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>

                    <Label text="Phone Number or E-mail" GridPane.columnIndex="0" GridPane.rowIndex="0">
                  <GridPane.margin>
                     <Insets bottom="15.0" />
                  </GridPane.margin></Label>
                    <TextField promptText="Enter Email/Phone" GridPane.columnIndex="1" GridPane.rowIndex="0">
                  <GridPane.margin>
                     <Insets bottom="15.0" />
                  </GridPane.margin></TextField>

                    <Label text="Password" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField promptText="Your Account Password" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </GridPane>

                <Button mnemonicParsing="false" prefWidth="100.0" styleClass="primary-btn" text="Continue">
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </Button>

                <Separator prefHeight="6.0" prefWidth="600.0">
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </Separator>

                <Label alignment="CENTER" styleClass="accent" text="Never signed in before? Register now or enter as a guest!" textAlignment="CENTER" wrapText="true" />

                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <Button mnemonicParsing="false" styleClass="primary-btn" text="Register">
                            <HBox.margin>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </HBox.margin>
                        </Button>
                        <Button mnemonicParsing="false" styleClass="primary-btn" text="Guest Mode">
                            <HBox.margin>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
